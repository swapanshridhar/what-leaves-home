# Copy to .env and fill in. Leave everything empty to see demo devices.

# Your AdGuard Home: the address you open its web page at, plus its login.
WL_ADGUARD_URL=http://192.168.1.2:3000
WL_ADGUARD_USER=
WL_ADGUARD_PASSWORD=

# Or Pi-hole 6 instead (an app password from Settings → Web interface / API):
# WL_PIHOLE_URL=http://192.168.1.2
# WL_PIHOLE_PASSWORD=

# Optional: friendly names for devices AdGuard doesn't already name.
# WL_NAMES=192.168.1.20=Living room TV,192.168.1.21=Kitchen speaker

# Optional: only these devices (comma-separated addresses).
# WL_CLIENTS=192.168.1.20,192.168.1.21

# Optional: how many days to keep (default 30), how often to read in seconds (default 300).
# WL_KEEP_DAYS=30
# WL_POLL_SECONDS=300
